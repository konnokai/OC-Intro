---
import Base from '../layouts/Base.astro';
---

<Base title="找不到這一頁" noindex>
  <section class="band surface-night not-found">
    <div class="wrap">
      <h1>找不到這一頁</h1>
      <p class="not-found__link"><a class="text-link" href="/">回首頁</a></p>
    </div>
  </section>
</Base>

<style>
  .not-found {
    display: grid;
    place-items: center;
    min-block-size: 60svh;
    text-align: center;
  }

  .not-found h1 {
    font-size: clamp(2.25rem, 1.5rem + 4vw, 4.5rem);
  }

  .not-found__link {
    margin-block-start: 1.5rem;
  }
</style>
