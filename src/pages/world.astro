---
import Base from '../layouts/Base.astro';
import VSection from '../components/VSection.astro';
import { world } from '../data/world';
---

<Base title="幻月界">
  <section class="band surface-night page-head">
    <div class="wrap">
      <h1 class="page-head__title">{world.name}</h1>
      <p class="page-head__romaji">{world.romaji}</p>
      <p class="page-head__subtitle">{world.subtitle}</p>
      <p class="page-head__epigraph">{world.epigraph}</p>
    </div>
  </section>

  <section class="band surface-moon">
    <div class="wrap">
      <VSection heading={world.overview.heading}>
        {world.overview.paragraphs.map((paragraph) => <p set:html={paragraph} />)}
      </VSection>

      <VSection heading={world.races.heading}>
        <div class="races">
          {
            world.races.items.map((race) => (
              <section class="race">
                <h3>
                  {race.name}
                  <span class="race__alias">{race.alias}</span>
                </h3>
                <p>{race.text}</p>
              </section>
            ))
          }
        </div>
      </VSection>

      <VSection heading={world.places.heading}>
        <dl class="places">
          {
            world.places.items.map((place) => (
              <div>
                <dt>
                  {place.name}
                  <span class="places__alias" lang="ja">{place.alias}</span>
                </dt>
                <dd>{place.text}</dd>
              </div>
            ))
          }
        </dl>
      </VSection>
    </div>
  </section>

  <section class="band surface-night">
    <div class="wrap">
      <VSection heading={world.conflict.heading}>
        {world.conflict.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </VSection>
      <p class="page-next"><a class="text-link" href="/bond/">接著讀：兩人的羈絆</a></p>
    </div>
  </section>
</Base>

<style>
  .page-head__title {
    font-size: clamp(2.25rem, 1.5rem + 4vw, 4.5rem);
  }

  .page-head__romaji {
    color: var(--soft);
    font-size: 1.125rem;
  }

  .page-head__subtitle {
    margin-block-start: 0.25rem;
    font-size: 1.25rem;
  }

  .page-head__epigraph {
    margin-block-start: 1.5rem;
    font-family: var(--font-kai);
    color: var(--mist);
    font-size: clamp(1.25rem, 1rem + 1.2vw, 1.75rem);
    max-inline-size: 30em;
  }

  .races {
    display: grid;
    gap: 2rem;
  }

  .race h3 {
    font-size: 1.25rem;
  }

  .race__alias {
    margin-inline-start: 0.6em;
    color: var(--soft);
    font-size: 0.85em;
    font-weight: 400;
  }

  .race p {
    margin-block-start: 0.5rem;
  }

  .places {
    display: grid;
    /* 說明欄維持在一行 36 字以內：內文欄寬加上地名欄和間距 */
    max-inline-size: calc(var(--measure) + 12.5rem);
  }

  .places > div {
    display: grid;
    gap: 0.25rem;
    padding-block: 0.85rem;
  }

  .places > div + div {
    border-block-start: 1px solid var(--rule);
  }

  .places dt {
    font-weight: 700;
  }

  .places__alias {
    display: block;
    color: var(--soft);
    font-size: 0.875rem;
    font-weight: 400;
  }

  .page-next {
    margin-block-start: clamp(3rem, 7vw, 5rem);
  }

  @media (min-width: 56rem) {
    .races {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.5rem 3rem;
    }

    .places > div {
      grid-template-columns: 11rem minmax(0, 1fr);
      gap: 1.5rem;
    }
  }
</style>
