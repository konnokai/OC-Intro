---
import { Image } from 'astro:assets';

import Base from '../layouts/Base.astro';
import VSection from '../components/VSection.astro';
import Artwork from '../components/Artwork.astro';
import twinstarLogo from '../assets/logo/twinstar.png';
import { site } from '../data/site';
import { characters } from '../data/characters';
import { world } from '../data/world';
import { bond } from '../data/bond';
import { artworks } from '../data/artworks';

const cast = [characters.koro, characters.yoraya];
---

<Base>
  <section class="hero">
    <div class="hero__center">
      <h1 class="hero__moon">
        <Image
          src={twinstarLogo}
          alt={`${site.name} ${site.nameEn}`}
          widths={[240, 480, 720]}
          sizes="(min-width: 48rem) 23vw, 48vw"
          loading="eager"
        />
      </h1>
      <p class="hero__sub">{site.title}</p>
      <p class="hero__epigraph">{site.epigraph}</p>
    </div>
    <a class="hero__figure hero__figure--koro" href="/koro/">
      <span class="hero__figure-img" style="view-transition-name: figure-koro">
        <Image
          src={characters.koro.figure.armed}
          alt=""
          loading="eager"
          fetchpriority="high"
          widths={[320, 480, 640, 960, 1280]}
          sizes="(min-width: 48rem) 30vw, 42vw"
        />
      </span>
      <span class="hero__label">皎朧 <span>Koro</span></span>
    </a>
    <a class="hero__figure hero__figure--yoraya" href="/yoraya/">
      <span class="hero__figure-img" style="view-transition-name: figure-yoraya">
        <Image
          src={characters.yoraya.figure.armed}
          alt=""
          loading="eager"
          fetchpriority="high"
          widths={[320, 480, 640, 960, 1280]}
          sizes="(min-width: 48rem) 36vw, 56vw"
        />
      </span>
      <span class="hero__label">夜綾 <span>Yoraya</span></span>
    </a>
  </section>

  <section class="cast band">
    <div class="wrap">
      <h2 class="cast__heading">角色</h2>
      {
        cast.map((c, index) => {
          const personality = c.sections.find((section) => section.id === 'personality');
          const facts = c.profile.filter((row) =>
            ['種族', '象徵意象', '代表色'].includes(row.label),
          );
          return (
            <article class:list={['cast__item', { 'cast__item--reverse': index === 1 }]}>
              <a class="cast__figure" href={`/${c.slug}/`}>
                <Image
                  src={c.card}
                  alt={c.cardAlt}
                  widths={[320, 480, 640, 960]}
                  sizes="(min-width: 48rem) 24rem, 90vw"
                />
              </a>
              <div class="cast__body">
                <h3 class="cast__name">
                  {c.name}
                  <span class="cast__reading">
                    {c.romaji} / <span lang="ja">{c.kana}</span>
                  </span>
                </h3>
                <p class="cast__role">{c.role}，{c.tagline}</p>
                <dl class="cast__facts">
                  {facts.map((row) => (
                    <div>
                      <dt>{row.label}</dt>
                      <dd>{row.value}</dd>
                    </div>
                  ))}
                </dl>
                <p class="cast__text">{personality?.paragraphs[0]}</p>
                <p class="cast__more">
                  <a class="text-link" href={`/${c.slug}/`}>看{c.name}的設定與立繪</a>
                </p>
              </div>
            </article>
          );
        })
      }
    </div>
  </section>

  <section class="band surface-moon">
    <div class="wrap">
      <VSection heading="幻月界">
        <p set:html={world.overview.paragraphs[0]} />
        <p><a class="text-link" href="/world/">讀幻月界的世界觀</a></p>
      </VSection>
    </div>
  </section>

  <section class="band surface-night">
    <div class="wrap bond-teaser">
      <div class="bond-teaser__art">
        <Artwork item={artworks.adou6Embrace} sizes="(min-width: 40rem) 40rem, 92vw" />
      </div>
      <blockquote class="quote">
        <p>{bond.closing}</p>
      </blockquote>
      <p class="bond-teaser__link"><a class="text-link" href="/bond/">讀兩人的羈絆</a></p>
    </div>
  </section>

  <section class="surface-shu notice">
    <div class="wrap">
      <p>二創、委託、商用之前，請先讀<a class="text-link" href="/guidelines/">創作規範</a>。</p>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    overflow: clip;
    padding-inline: var(--gutter);
    padding-block-start: 2rem;
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    column-gap: 0.75rem;
    align-items: end;
    grid-template-areas:
      "center center"
      "koro yoraya";
  }

  .hero__center {
    grid-area: center;
    display: grid;
    justify-items: center;
    gap: 1rem;
    text-align: center;
    padding-block-end: 1.5rem;
  }

  .hero__moon {
    inline-size: min(70vw, 20rem);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    margin: 0;
    border-radius: 50%;
    background: var(--moon);
  }

  .hero__moon img {
    inline-size: 68%;
    block-size: auto;
  }

  .hero__sub {
    font-size: 1.125rem;
  }

  .hero__epigraph {
    font-family: var(--font-kai);
    color: var(--mist);
    max-inline-size: 22em;
    text-wrap: balance;
  }

  .hero__figure {
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    padding-block-end: 1.5rem;
    color: inherit;
    text-decoration: none;
  }

  .hero__figure--koro {
    grid-area: koro;
  }

  .hero__figure--yoraya {
    grid-area: yoraya;
  }

  .hero__figure-img,
  .hero__figure-img img {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }

  .hero__label {
    font-size: 1.125rem;
    font-weight: 900;
  }

  .hero__label span {
    color: var(--soft);
    font-weight: 400;
  }

  .hero__figure:hover .hero__label {
    text-decoration: underline;
    text-decoration-color: var(--shu);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35em;
  }

  @media (min-width: 48rem) {
    .hero {
      grid-template-columns: 1fr;
      grid-template-areas: "center";
      place-items: center;
      min-block-size: clamp(30rem, 52vw, 52rem);
      padding-block: 3rem;
    }

    .hero__moon {
      inline-size: clamp(16rem, 34vw, 30rem);
    }

    .hero__figure {
      display: block;
      grid-area: auto;
      position: absolute;
      inset-block-end: 0;
      z-index: 2;
      padding: 0;
    }

    .hero__figure--koro {
      inset-inline-end: calc(50% + clamp(7rem, 15vw, 14rem));
      /* 兩人設定身高只差 2 cm，立繪又都頂滿畫布，所以和夜綾寫一樣的高度 */
      block-size: min(92%, 41vw);
    }

    .hero__figure--yoraya {
      /* 夜綾的畫布比較寬，往中間靠才不會超出右邊 */
      inset-inline-start: calc(50% + clamp(6rem, 13vw, 14rem));
      block-size: min(92%, 41vw);
    }

    /* 貼著底邊的立繪，往外推的焦點框會被 .hero 的 overflow 切掉，改畫在裡面 */
    .hero__figure:focus-visible {
      outline-offset: -4px;
    }

    /* 兩側立繪之間的空間隨寬度變窄，題詞跟著收窄才不會被立繪蓋住 */
    .hero__epigraph {
      max-inline-size: min(22em, 25vw);
    }

    .hero__figure-img {
      block-size: 100%;
      inline-size: auto;
    }

    .hero__figure-img img {
      block-size: 100%;
      inline-size: auto;
      max-inline-size: none;
    }

    .hero__center {
      z-index: 1;
    }

    .hero__label {
      position: absolute;
      top: 8%;
      writing-mode: vertical-rl;
      letter-spacing: 0.3em;
      font-weight: 900;
      font-size: 1.25rem;
    }

    .hero__figure--koro .hero__label {
      left: 0;
    }

    .hero__figure--yoraya .hero__label {
      right: 0;
    }
  }

  /* 平板寬度立繪比較小，直排的羅馬字會壓到人物，只留中文名 */
  @media (min-width: 48rem) and (max-width: 63.99rem) {
    .hero__label span {
      display: none;
    }
  }

  .cast__heading {
    font-size: clamp(2rem, 1.5rem + 2.5vw, 3rem);
    margin-block-end: 2rem;
  }

  .cast__item {
    display: grid;
    gap: 1.25rem;
  }

  .cast__item + .cast__item {
    margin-block-start: clamp(3rem, 7vw, 6rem);
  }

  .cast__figure {
    display: block;
    max-inline-size: 24rem;
  }

  .cast__figure img {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }

  .cast__name {
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.5rem);
  }

  .cast__reading {
    margin-inline-start: 0.5em;
    color: var(--soft);
    font-size: 0.55em;
    font-weight: 400;
  }

  .cast__role {
    margin-block-start: 0.25rem;
    font-size: 1rem;
  }

  .cast__facts {
    display: grid;
    gap: 0.25rem;
    margin-block-start: 1rem;
    font-size: 0.9375rem;
  }

  .cast__facts > div {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.75rem;
  }

  .cast__facts dt {
    flex: 0 0 5.5em;
    color: var(--soft);
  }

  .cast__text {
    margin-block-start: 1rem;
    max-inline-size: var(--measure);
  }

  .cast__more {
    margin-block-start: 0.75rem;
  }

  @media (min-width: 48rem) {
    .cast__item {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      gap: clamp(2rem, 5vw, 4rem);
      align-items: start;
    }

    .cast__item--reverse .cast__figure {
      grid-column: 2;
      grid-row: 1;
      justify-self: end;
    }

    .cast__item--reverse .cast__body {
      grid-column: 1;
      grid-row: 1;
    }
  }

  .bond-teaser {
    text-align: center;
  }

  .bond-teaser__art {
    max-inline-size: 40rem;
    margin-inline: auto;
    margin-block-end: 2rem;
  }

  .bond-teaser__link {
    margin-block-start: 2rem;
  }

  .notice {
    padding-block: 2rem;
  }
</style>
