---
import { site, xUrl } from '../data/site';

const owner = site.owner;
---

<footer class="site-footer surface-night">
  <div class="wrap site-footer__inner">
    <dl class="site-footer__credits">
      <div>
        <dt>角色所有</dt>
        <dd>
          {owner.name}（<a class="text-link" href={xUrl(owner.x)} target="_blank" rel="noopener"
            >@{owner.x}</a
          >）
        </dd>
      </div>
      {
        site.credits.map((credit) => (
          <div>
            <dt>{credit.role}</dt>
            <dd>
              {credit.name}（<a class="text-link" href={xUrl(credit.x)} target="_blank" rel="noopener"
                >@{credit.x}</a
              >）
            </dd>
          </div>
        ))
      }
    </dl>
    <a class="text-link site-footer__guidelines" href="/guidelines/">創作規範</a>
  </div>
</footer>

<style>
  .site-footer {
    border-block-start: 1px solid var(--rule);
    padding-block: 2.5rem 3rem;
    font-size: 0.9375rem;
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1.5rem 3rem;
  }

  .site-footer__credits {
    display: grid;
    gap: 0.25rem;
  }

  .site-footer__credits > div {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.75rem;
  }

  .site-footer__credits dt {
    color: var(--soft);
  }
</style>
